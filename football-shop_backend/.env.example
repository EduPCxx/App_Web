# Puerto del servidor
PORT=3000

# Conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/football_products

# Orígenes permitidos por CORS (separados por comas). Usa * para permitir todos.
CORS_ORIGIN=*

# Contraseña opcional para el usuario de ejemplo creado por el seed.
SEED_USER_PASSWORD=

# Entorno: development | production
NODE_ENV=development

# JWT (configura SECRET con un valor aleatorio y privado)
SECRET=change-me-with-a-long-random-secret
EXPIRES_IN=1h
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
