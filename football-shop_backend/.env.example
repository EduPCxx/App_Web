# Puerto del servidor
PORT=3000

# Conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/football_products

# Orígenes permitidos por CORS (separados por comas). Usa * para permitir todos.
CORS_ORIGIN=*

# Define una contraseña local para crear el admin en una base de datos nueva.
SEED_ADMIN_PASSWORD=

# Entorno: development | production
NODE_ENV=development

# JWT (configura SECRET con un valor aleatorio y privado)
SECRET=Tres tristes tigres, tragaban trigo en un trigal, en tres tristes trastos, tragaban trigo tres tristes tigres.
EXPIRES_IN=1h
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
