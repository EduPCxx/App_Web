# Puerto del servidor
PORT=3000

# Conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/football_products

# Orígenes permitidos por CORS (separados por comas). Usa * para permitir todos.
CORS_ORIGIN=*

# Contraseña opcional para el usuario de ejemplo creado por el seed.
SEED_USER_PASSWORD=

# Entorno: development | production
NODE_ENV=development
